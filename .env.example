DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require
ADMIN_API_KEY=replace-with-a-long-random-secret
# Optional (for platforms that prefix env vars, e.g. HANDY_)
HANDY_POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require
HANDY_ADMIN_API_KEY=replace-with-a-long-random-secret
